---
interface Props {
  id: string;
  title: string;
  tone?: "plain" | "soft";
}

const { id, title, tone = "plain" } = Astro.props;
---

<section id={id} class:list={["section", { "section-soft": tone === "soft" }]}>
  <div class="container">
    <div class="section-head" data-reveal>
      <h2>{title}</h2>
      <slot name="aside" />
    </div>
    <slot />
  </div>
</section>
